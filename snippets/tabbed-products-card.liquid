{%- doc -%}
  Renders a product card for the tabbed products section.
  Displays product image with optional sticker badge, star rating,
  title, type, price with compare-at strikethrough, and tag badges.

  @param {product} product - The product to render
  @param {string} [card_background] - Background color for the image wrapper

  @example
  {% render 'tabbed-products-card', product: product, card_background: '#F9EFE1' %}
{%- enddoc -%}

{%- liquid
  assign card_background = card_background | default: '#F9EFE1'
  assign selected_variant = product.selected_or_first_available_variant
  assign price = selected_variant.price
  assign compare_at_price = selected_variant.compare_at_price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif

  assign rating_value = product.metafields.reviews.rating.value.rating
  assign scale_max = product.metafields.reviews.rating.value.scale_max | default: 5
  assign rating_count = product.metafields.reviews.rating_count.value

  assign sticker_file = blank
  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower contains 'sticker:'
      assign sticker_file = tag | split: ':' | last | strip
    endif
  endfor
-%}

<a href="{{ product.url }}" class="tabbed-products-card">
  <div class="tabbed-products-card__image-wrapper" style="background-color: {{ card_background }};">
    {%- if product.featured_image != blank -%}
      <img
        src="{{ product.featured_image | image_url: width: 500 }}"
        alt="{{ product.featured_image.alt | escape }}"
        width="245"
        height="245"
        loading="lazy"
        class="tabbed-products-card__image"
      >
    {%- endif -%}
    {%- if sticker_file != blank -%}
      <img
        src="{{ sticker_file | asset_url }}"
        alt=""
        class="tabbed-products-card__sticker"
        width="85"
        height="38"
        loading="lazy"
      >
    {%- endif -%}
  </div>

  <div class="tabbed-products-card__info">
    {%- if rating_value != blank -%}
      {%- liquid
        assign decimal = rating_value | modulo: 1
        assign decimal_rating = 0
        if decimal >= 0.3 and decimal <= 0.7
          assign decimal_rating = 0.5
        elsif decimal > 0.7
          assign decimal_rating = 1
        endif
        assign decimal_rounded = decimal_rating | ceil
        assign svg_filled_stars = rating_value | floor | plus: decimal_rounded
      -%}
      <div class="tabbed-products-card__rating">
        <svg class="visually-hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" role="presentation" style="width:0;height:0;">
          <defs>
            <linearGradient id="tabbed-half-{{ product.id }}" x1="0" x2="100%" y1="0" y2="0">
              <stop offset="50%" stop-color="#D53E27"></stop>
              <stop offset="50%" stop-color="transparent"></stop>
            </linearGradient>
            <symbol viewBox="0 0 32 32" id="tabbed-star-{{ product.id }}">
              <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
            </symbol>
          </defs>
        </svg>
        <div class="tabbed-products-card__stars">
          {%- for star in (1..5) -%}
            <svg
              class="tabbed-products-card__star {% if star <= svg_filled_stars %}tabbed-products-card__star--filled{% endif %}"
              viewBox="0 0 32 32"
              role="presentation"
            >
              <use xlink:href="#tabbed-star-{{ product.id }}"{% if decimal_rating == 0.5 and star == svg_filled_stars %} fill="url(#tabbed-half-{{ product.id }})"{% endif %}></use>
            </svg>
          {%- endfor -%}
        </div>
        {%- if rating_count != blank -%}
          {%- liquid
            assign count_num = rating_count | plus: 0
            if count_num >= 1000
              assign count_k = count_num | divided_by: 1000
              assign count_display = count_k | append: 'K'
            else
              assign count_display = rating_count
            endif
          -%}
          <span class="tabbed-products-card__review-count">{{ count_display }} Reviews</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <p class="tabbed-products-card__title">{{ product.title }}</p>
    <p class="tabbed-products-card__type">{{ product.type }}</p>

    <div class="tabbed-products-card__price">
      {%- if on_sale -%}
        <span class="tabbed-products-card__price-compare">{{ compare_at_price | money }}</span>
      {%- endif -%}
      <span class="tabbed-products-card__price-current{% if on_sale %} tabbed-products-card__price-current--sale{% endif %}">{{ price | money }}</span>
    </div>

    {%- liquid
      assign has_badges = false
      assign sale_percent = 0
      if on_sale
        assign has_badges = true
        assign discount = compare_at_price | minus: price
        assign sale_percent = discount | times: 100 | divided_by: compare_at_price
      endif

      assign is_best_seller = false
      assign is_just_dropped = false
      for tag in product.tags
        assign tag_down = tag | downcase
        if tag_down == 'best seller'
          assign is_best_seller = true
        endif
        if tag_down == 'just dropped'
          assign is_just_dropped = true
        endif
      endfor

      if is_best_seller or is_just_dropped
        assign has_badges = true
      endif
    -%}

    {%- if has_badges -%}
      <div class="tabbed-products-card__badges">
        {%- if on_sale -%}
          <span class="tabbed-products-card__badge tabbed-products-card__badge--sale">{{ sale_percent }}% Off</span>
        {%- endif -%}
        {%- if is_just_dropped -%}
          <span class="tabbed-products-card__badge tabbed-products-card__badge--just-dropped">Just Dropped</span>
        {%- endif -%}
        {%- if is_best_seller -%}
          <span class="tabbed-products-card__badge tabbed-products-card__badge--best-seller">Best Seller</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</a>

{% stylesheet %}
  .tabbed-products-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    color: inherit;
  }

  .tabbed-products-card__image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tabbed-products-card__image {
    width: 79%;
    height: 79%;
    object-fit: contain;
  }

  .tabbed-products-card__sticker {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 85px;
    height: 38px;
  }

  .tabbed-products-card__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tabbed-products-card__rating {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .tabbed-products-card__stars {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .tabbed-products-card__star {
    width: 16px;
    height: 16px;
    fill: transparent;
  }

  .tabbed-products-card__star--filled {
    fill: #D53E27;
  }

  .tabbed-products-card__review-count {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 16px;
    color: #7C665B;
    white-space: nowrap;
  }

  .tabbed-products-card__title {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 24px;
    line-height: 24px;
    color: #3F2F27;
    margin: 0;
  }

  .tabbed-products-card__type {
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #3F2F27;
    margin: 0;
  }

  .tabbed-products-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tabbed-products-card__price-compare {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #3F2F27;
    text-decoration: line-through;
  }

  .tabbed-products-card__price-current {
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: -0.25px;
    color: #3F2F27;
  }

  .tabbed-products-card__badges {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .tabbed-products-card__badge {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 10px;
    line-height: 12px;
    color: #FDF8F2;
    padding: 4px 6px;
    border-radius: 0 8px 0 8px;
    white-space: nowrap;
  }

  .tabbed-products-card__badge--sale {
    background-color: #E82911;
  }

  .tabbed-products-card__badge--best-seller {
    background-color: #697793;
  }

  .tabbed-products-card__badge--just-dropped {
    background-color: #DAA64F;
  }
{% endstylesheet %}
