{%- liquid
  assign collection_1 = section.settings.collection_1
  assign collection_2 = section.settings.collection_2
  assign max_products = section.settings.max_products
  assign has_two_collections = false
  if collection_1 != blank and collection_2 != blank
    assign has_two_collections = true
  endif
-%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

<most-popular-tabs
  class="most-popular spacing-style color-custom-{{ section.id }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --mp-tab-active-color: {{ section.settings.tab_active_color }};
    --mp-badge-discount: {{ section.settings.badge_discount_color }};
    --mp-badge-bestseller: {{ section.settings.badge_bestseller_color }};
    --mp-badge-new: {{ section.settings.badge_new_color }};
    --mp-heading-color: {{ section.settings.heading_color }};
    --mp-card-bg: {{ section.settings.card_background_color }};
  "
>
  <div class="most-popular__container">
    <div class="most-popular__header">
      <div class="most-popular__header-text">
        <h2 class="most-popular__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="most-popular__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="most-popular__header-actions">
        {%- if has_two_collections -%}
          <div class="most-popular__tabs">
            <button
              type="button"
              class="most-popular__tab most-popular__tab--active"
              ref="tabs[]"
              on:click="/switchTab"
              data-tab="0"
            >
              {{ section.settings.tab_label_1 }}
            </button>
            <button
              type="button"
              class="most-popular__tab"
              ref="tabs[]"
              on:click="/switchTab"
              data-tab="1"
            >
              {{ section.settings.tab_label_2 }}
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.shop_all_label != blank and section.settings.shop_all_url != blank -%}
          <a href="{{ section.settings.shop_all_url }}" class="most-popular__shop-all">
            {{ section.settings.shop_all_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if collection_1 != blank -%}
      <div class="most-popular__grid" ref="grids[]" data-tab-content="0">
        {%- for product in collection_1.products limit: max_products -%}
          {% render 'most-popular-card',
            product: product,
            card_bg_color: section.settings.card_background_color,
            yotpo_instance_id: section.settings.yotpo_instance_id
          %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if collection_2 != blank -%}
      <div class="most-popular__grid" ref="grids[]" data-tab-content="1" hidden>
        {%- for product in collection_2.products limit: max_products -%}
          {% render 'most-popular-card',
            product: product,
            card_bg_color: section.settings.card_background_color,
            yotpo_instance_id: section.settings.yotpo_instance_id
          %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</most-popular-tabs>

<script type="module">
  import { Component } from '@theme/component';

  class MostPopularTabs extends Component {
    switchTab(event) {
      const clickedTab = event.currentTarget;
      const tabIndex = clickedTab.dataset.tab;

      if (!this.refs.tabs || !this.refs.grids) return;

      for (const tab of this.refs.tabs) {
        if (tab.dataset.tab === tabIndex) {
          tab.classList.add('most-popular__tab--active');
        } else {
          tab.classList.remove('most-popular__tab--active');
        }
      }

      for (const grid of this.refs.grids) {
        if (grid.dataset.tabContent === tabIndex) {
          grid.removeAttribute('hidden');
        } else {
          grid.setAttribute('hidden', '');
        }
      }
    }
  }

  customElements.define('most-popular-tabs', MostPopularTabs);
</script>

{% stylesheet %}
  .most-popular {
    display: block;
  }

  .most-popular__container {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .most-popular__header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-inline: 40px;
  }

  .most-popular__header-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .most-popular__heading {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 48px;
    line-height: 48px;
    margin: 0;
    color: var(--mp-heading-color, inherit);
  }

  .most-popular__subheading {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    margin: 0;
  }

  .most-popular__header-actions {
    display: flex;
    flex-direction: row;
    gap: 32px;
    align-items: center;
  }

  .most-popular__tabs {
    display: flex;
    flex-direction: row;
    gap: 26px;
    align-items: center;
  }

  .most-popular__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: transparent;
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: 4px;
    color: inherit;
  }

  .most-popular__tab--active {
    border: 1px solid var(--mp-tab-active-color);
    border-radius: 0;
    color: var(--mp-tab-active-color);
  }

  .most-popular__shop-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: 1px solid var(--mp-tab-active-color);
    border-radius: 4px;
    color: var(--mp-tab-active-color);
    text-decoration: none;
    background: transparent;
    cursor: pointer;
  }

  .most-popular__grid {
    display: flex;
    flex-direction: row;
    gap: 16px;
    overflow-x: auto;
    padding-inline: 40px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .most-popular__grid::-webkit-scrollbar {
    display: none;
  }

  .most-popular__grid[hidden] {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .most-popular__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding-inline: 20px;
    }

    .most-popular__header-actions {
      width: 100%;
      flex-wrap: wrap;
      gap: 16px;
    }

    .most-popular__tabs {
      flex-wrap: wrap;
      gap: 12px;
    }

    .most-popular__heading {
      font-size: 36px;
      line-height: 36px;
    }

    .most-popular__grid {
      padding-inline: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Most Popular Products",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Most Popular"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Classic solids. Bold prints. Endless options."
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "text",
      "id": "tab_label_1",
      "label": "Tab label 1",
      "default": "Men's"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "text",
      "id": "tab_label_2",
      "label": "Tab label 2",
