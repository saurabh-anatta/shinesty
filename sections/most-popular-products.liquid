    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FDF8F2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3F2F27"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3F2F27"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#F9EFE1"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Active tab color",
      "default": "#D53E27"
    },
    {
      "type": "color",
      "id": "badge_discount_color",
      "label": "Discount badge color",
      "default": "#E82911"
    },
    {
      "type": "color",
      "id": "badge_bestseller_color",
      "label": "Best seller badge color",
      "default": "#697793"
    },
    {
      "type": "color",
      "id": "badge_new_color",
      "label": "New badge color",
      "default": "#DAA64F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
