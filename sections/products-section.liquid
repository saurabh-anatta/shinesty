<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&display=swap" rel="stylesheet">

{%- liquid
  assign bg_color = section.settings.background_color
  assign card_bg = section.settings.card_background_color
  assign heading_color = section.settings.heading_color
  assign active_color = section.settings.active_filter_color
  assign pt = section.settings.padding-block-start
  assign pb = section.settings.padding-block-end
-%}

<section
  class="products-section"
  style="--products-bg: {{ bg_color }}; --products-card-bg: {{ card_bg }}; --products-heading-color: {{ heading_color }}; --products-active-filter-color: {{ active_color }}; --products-padding-top: {{ pt }}px; --products-padding-bottom: {{ pb }}px;"
>
  <div class="products-section__container">
    <div class="products-section__header">
      <div class="products-section__title-group">
        {%- if section.settings.heading != blank -%}
          <h2 class="products-section__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="products-section__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
      <div class="products-section__actions">
        <div class="products-section__filters">
          {%- if section.settings.filter_1_text != blank -%}
            <a
              href="{{ section.settings.filter_1_link }}"
              class="products-section__filter-btn products-section__filter-btn--active"
            >
              {{- section.settings.filter_1_text -}}
            </a>
          {%- endif -%}
          {%- if section.settings.filter_2_text != blank -%}
            <a
              href="{{ section.settings.filter_2_link }}"
              class="products-section__filter-btn"
            >
              {{- section.settings.filter_2_text -}}
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.shop_all_text != blank -%}
          <a
            href="{{ section.settings.shop_all_link }}"
            class="products-section__shop-all-btn"
          >
            {{- section.settings.shop_all_text -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="products-section__cards">
      {%- for block in section.blocks -%}
        <div class="products-section__card" {{ block.shopify_attributes }}>
          <div class="products-section__card-image-wrap">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 490 }}"
                alt="{{ block.settings.product_title | escape }}"
                width="245"
                height="245"
                loading="lazy"
                class="products-section__card-image"
              >
            {%- endif -%}
            {%- if block.settings.sticker_asset != blank -%}
              <img
                src="{{ block.settings.sticker_asset | asset_url }}"
                alt=""
                width="85"
                height="38"
                class="products-section__card-sticker"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          <div class="products-section__card-info">
            <div class="products-section__rating">
              <div class="products-section__star-icons">
                <img src="{{ 'star-solid.svg' | asset_url }}" alt="" width="16" height="16">
                <img src="{{ 'star-solid.svg' | asset_url }}" alt="" width="16" height="16">
                <img src="{{ 'star-solid.svg' | asset_url }}" alt="" width="16" height="16">
                <img src="{{ 'star-solid.svg' | asset_url }}" alt="" width="16" height="16">
                <img src="{{ 'star-half-alt-solid.svg' | asset_url }}" alt="" width="16" height="16">
              </div>
              {%- if block.settings.rating_text != blank -%}
                <span class="products-section__review-count">{{ block.settings.rating_text }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.product_title != blank -%}
              <h3 class="products-section__product-title">{{ block.settings.product_title }}</h3>
            {%- endif -%}
            {%- if block.settings.product_type != blank -%}
              <p class="products-section__product-type">{{ block.settings.product_type }}</p>
            {%- endif -%}
            <div class="products-section__price-group">
              {%- if block.settings.compare_at_price != blank -%}
                <span class="products-section__compare-price">{{ block.settings.compare_at_price }}</span>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <span class="products-section__price">{{ block.settings.price }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.tag_1_text != blank or block.settings.tag_2_text != blank -%}
              <div class="products-section__tags">
                {%- if block.settings.tag_1_text != blank -%}
                  <span
                    class="products-section__tag"
                    style="background-color: {{ block.settings.tag_1_color }};"
                  >
                    {{- block.settings.tag_1_text -}}
                  </span>
                {%- endif -%}
                {%- if block.settings.tag_2_text != blank -%}
                  <span
                    class="products-section__tag"
                    style="background-color: {{ block.settings.tag_2_color }};"
                  >
                    {{- block.settings.tag_2_text -}}
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .products-section {
    background-color: var(--products-bg, #FDF8F2);
    padding-block-start: var(--products-padding-top, 64px);
    padding-block-end: var(--products-padding-bottom, 64px);
  }

  .products-section__container {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 40px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .products-section__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .products-section__title-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .products-section__heading {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 48px;
    line-height: 48px;
    color: var(--products-heading-color, #3F2F27);
    margin: 0;
  }

  .products-section__subtext {
    font-family: 'Lexend', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: var(--products-heading-color, #3F2F27);
    margin: 0;
  }

  .products-section__actions {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .products-section__filters {
    display: flex;
    gap: 26px;
    align-items: center;
  }

  .products-section__filter-btn {
    font-family: 'Lexend', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 8px 12px;
    text-decoration: none;
    color: var(--products-heading-color, #3F2F27);
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    justify-content: center;
    align-items: center;
  }

  .products-section__filter-btn--active {
    color: var(--products-active-filter-color, #D53E27);
    border: 1px solid var(--products-active-filter-color, #D53E27);
  }

  .products-section__shop-all-btn {
    font-family: 'Lexend', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 8px 12px;
    text-decoration: none;
    color: var(--products-active-filter-color, #D53E27);
    border: 1px solid var(--products-active-filter-color, #D53E27);
    border-radius: 4px;
    background: none;
    cursor: pointer;
    display: inline-flex;
    justify-content: center;
    align-items: center;
  }

  .products-section__cards {
    display: flex;
    gap: 16px;
    overflow: hidden;
  }

  .products-section__card {
    flex: 0 0 calc((100% - 64px) / 4.3);
    min-width: 220px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .products-section__card-image-wrap {
    aspect-ratio: 1 / 1;
    background-color: var(--products-card-bg, #F9EFE1);
    border-radius: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .products-section__card-image {
    width: 79%;
    height: auto;
    object-fit: contain;
  }

  .products-section__card-sticker {
    position: absolute;
    top: 8px;
    inset-inline-end: 8px;
    width: 85px;
    height: 38px;
  }

  .products-section__card-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .products-section__rating {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .products-section__star-icons {
    display: flex;
    align-items: center;
  }

  .products-section__star-icons img {
    width: 16px;
    height: 16px;
  }

  .products-section__review-count {
    font-family: 'Lexend', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 16px;
    color: #7C665B;
  }

  .products-section__product-title {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 24px;
    line-height: 24px;
    color: var(--products-heading-color, #3F2F27);
    margin: 0;
  }

  .products-section__product-type {
    font-family: 'Lexend', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--products-heading-color, #3F2F27);
    margin: 0;
  }

  .products-section__price-group {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .products-section__compare-price {
    font-family: 'Lexend', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    text-decoration: line-through;
    color: var(--products-heading-color, #3F2F27);
  }

  .products-section__price {
    font-family: 'Lexend', sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: -0.25px;
    color: var(--products-heading-color, #3F2F27);
  }

  .products-section__tags {
    display: flex;
    gap: 4px;
  }

  .products-section__tag {
    font-family: 'Lexend', sans-serif;
    font-weight: 600;
    font-size: 10px;
    line-height: 12px;
    color: #FDF8F2;
    padding: 4px 6px;
    border-radius: 0 8px 0 8px;
  }

  @media screen and (max-width: 40em) {
    .products-section__container {
      padding-inline: 16px;
      gap: 24px;
    }

    .products-section__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .products-section__heading {
      font-size: 36px;
      line-height: 36px;
    }

    .products-section__cards {
      flex-wrap: wrap;
      overflow: visible;
    }

    .products-section__card {
      flex: 0 0 calc(50% - 8px);
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Products section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Most Popular"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Classic solids. Bold prints. Endless options."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3F2F27"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FDF8F2"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#F9EFE1"
    },
    {
      "type": "color",
      "id": "active_filter_color",
      "label": "Active filter color",
      "default": "#D53E27"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "text",
      "id": "filter_1_text",
      "label": "Filter 1 text",
      "default": "Men's"
    },
    {
      "type": "url",
      "id": "filter_1_link",
      "label": "Filter 1 link"
    },
    {
      "type": "text",
      "id": "filter_2_text",
      "label": "Filter 2 text",
      "default": "Women's"
    },
    {
      "type": "url",
      "id": "filter_2_link",
      "label": "Filter 2 link"
    },
    {
      "type": "text",
      "id": "shop_all_text",
      "label": "Shop All text",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop All link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "sticker_asset",
          "label": "Sticker SVG filename",
          "info": "Filename of sticker SVG in assets/ (e.g. with-fly-boxer-1.svg)"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product title",
          "default": "Product Title"
        },
        {
          "type": "text",
          "id": "product_type",
          "label": "Product type",
          "default": "Boxer brief"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$19.99"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare at price",
          "info": "Leave empty if no compare price"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating text",
          "default": "8K Reviews"
        },
        {
          "type": "header",
          "content": "Tags"
        },
        {
          "type": "text",
          "id": "tag_1_text",
          "label": "Tag 1 text"
        },
        {
          "type": "color",
          "id": "tag_1_color",
          "label": "Tag 1 color",
          "default": "#E82911"
        },
        {
          "type": "text",
          "id": "tag_2_text",
          "label": "Tag 2 text"
        },
        {
          "type": "color",
          "id": "tag_2_color",
          "label": "Tag 2 color",
          "default": "#697793"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products section",
      "blocks": []
    }
  ]
}
{% endschema %}
