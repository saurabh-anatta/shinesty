{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{%- if section.settings.show_stripes -%}
  <div class="footer-stripes">
    <div class="footer-stripes__band footer-stripes__band--1" style="background-color: {{ section.settings.stripe_color_1 }};"></div>
    <div class="footer-stripes__band footer-stripes__band--2" style="background-color: {{ section.settings.stripe_color_2 }};"></div>
    <div class="footer-stripes__band footer-stripes__band--3" style="background-color: {{ section.settings.stripe_color_3 }};"></div>
  </div>
{%- endif -%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  {%- liquid
    assign footer_logo = section.settings.footer_logo
    if footer_logo == blank
      assign footer_logo = settings.logo_inverse
    endif
    if footer_logo == blank
      assign footer_logo = settings.logo
    endif
  -%}
  {%- if footer_logo != blank -%}
    <div class="footer-logo-wrapper">
      {{
        footer_logo
        | image_url: width: 600
        | image_tag:
          class: 'footer-logo',
          loading: 'lazy',
          alt: shop.name,
          widths: '200,277,400,554',
          sizes: '(max-width: 749px) 200px, 277px'
      }}
    </div>
  {%- endif -%}

  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 5

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: grid_columns | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > grid_columns and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-stripes {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .footer-stripes__band {
    width: 100%;
  }

  .footer-stripes__band--1 {
    height: 19px;
  }

  .footer-stripes__band--2,
  .footer-stripes__band--3 {
    height: 7px;
  }

  .footer-logo-wrapper {
    padding: 48px 0 40px;
  }

  .footer-logo {
    max-width: 277px;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .footer-logo {
      max-width: 200px;
    }
  }

  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
    align-items: start;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
    color: #F9EFE1;
    font-size: 28px;
    line-height: 28px;
  }

  .footer-content .menu__item {
    color: #B59A8C;
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: -0.25px;
  }

  .footer-content .menu__item a {
    color: inherit;
  }

  .footer-content .details-content {
    margin-block-start: 24px;
  }

  .footer-content .menu__item + .menu__item {
    --spacing--size: 16px;
  }

  .footer-content .email-signup__input-group:not(.email-signup__input-group--integrated) {
    flex-direction: column;
    gap: 16px;
  }

  .footer-content .email-signup__button--text {
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logo"
    },
    {
      "type": "header",
      "content": "Stripes"
    },
    {
      "type": "checkbox",
      "id": "show_stripes",
      "label": "Show stripes",
      "default": false
    },
    {
      "type": "color",
      "id": "stripe_color_1",
      "label": "Stripe color 1",
      "default": "#E82911",
      "visible_if": "{{ section.settings.show_stripes }}"
    },
    {
      "type": "color",
      "id": "stripe_color_2",
      "label": "Stripe color 2",
      "default": "#F4762E",
      "visible_if": "{{ section.settings.show_stripes }}"
    },
    {
      "type": "color",
      "id": "stripe_color_3",
      "label": "Stripe color 3",
      "default": "#F4A044",
      "visible_if": "{{ section.settings.show_stripes }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 20,
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill"
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
