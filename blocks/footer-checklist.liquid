<div
  class="footer-checklist"
  style="
    --checklist-heading-color: {{ block.settings.heading_color | default: '#F9EFE1' }};
    --checklist-item-color: {{ block.settings.item_color | default: '#FDF8F2' }};
    --checklist-check-color: {{ block.settings.check_color | default: '#D53E27' }};
    --checklist-check-text-color: {{ block.settings.check_text_color | default: '#FDF8F2' }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h3 class="footer-checklist__heading">
      {{ block.settings.heading }}
    </h3>
  {%- endif -%}
  <ul class="footer-checklist__list list-unstyled">
    {%- if block.settings.item_1 != blank -%}
      <li class="footer-checklist__item">
        <span class="footer-checklist__check" aria-hidden="true">&#10003;</span>
        <span class="footer-checklist__text">{{ block.settings.item_1 }}</span>
      </li>
    {%- endif -%}
    {%- if block.settings.item_2 != blank -%}
      <li class="footer-checklist__item">
        <span class="footer-checklist__check" aria-hidden="true">&#10003;</span>
        <span class="footer-checklist__text">{{ block.settings.item_2 }}</span>
      </li>
    {%- endif -%}
    {%- if block.settings.item_3 != blank -%}
      <li class="footer-checklist__item">
        <span class="footer-checklist__check" aria-hidden="true">&#10003;</span>
        <span class="footer-checklist__text">{{ block.settings.item_3 }}</span>
      </li>
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .footer-checklist {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-checklist__heading {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 32px;
    line-height: 32px;
    color: var(--checklist-heading-color);
    margin: 0;
  }

  .footer-checklist__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .footer-checklist__item {
    display: flex;
    flex-direction: row;
    gap: 10px;
    align-items: center;
  }

  .footer-checklist__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    min-width: 20px;
    border-radius: 50%;
    background-color: var(--checklist-check-color);
    color: var(--checklist-check-text-color);
    font-size: 11px;
    line-height: 13px;
    text-align: center;
  }

  .footer-checklist__text {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: var(--checklist-item-color);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer checklist",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Emails suck. Ours don't."
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "Checklist item 1",
      "default": "Get 20% off your first order."
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "Checklist item 2",
      "default": "Confirm you're a genius."
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "Checklist item 3",
      "default": "Get award-winning product updates"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#F9EFE1"
    },
    {
      "type": "color",
      "id": "item_color",
      "label": "Item text color",
      "default": "#FDF8F2"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Checkmark background",
      "default": "#D53E27"
    },
    {
      "type": "color",
      "id": "check_text_color",
      "label": "Checkmark text color",
      "default": "#FDF8F2"
    }
  ],
  "presets": [
    {
      "name": "Footer checklist",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
